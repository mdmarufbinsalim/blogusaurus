{
  "name": "blogusaurus",
  "version": "0.1.0",
  "description": "Drop-in rich-text blog creator and renderer for Next.js / React.",
  "keywords": [
    "blog",
    "editor",
    "rich-text",
    "wysiwyg",
    "nextjs",
    "react",
    "react-server-components",
    "plate",
    "markdown"
  ],
  "author": "Md Maruf Bin Salim Bhuiyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdmarufbinsalim/blogusaurus.git",
    "directory": "packages/blogusaurus"
  },
  "homepage": "https://github.com/mdmarufbinsalim/blogusaurus#readme",
  "bugs": {
    "url": "https://github.com/mdmarufbinsalim/blogusaurus/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/build-css.mjs",
    "dev": "tsup --watch --onSuccess \"node scripts/build-css.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "pnpm build && pnpm typecheck"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.40",
    "@emoji-mart/data": "^1.2.1",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/basic-styles": "^53.0.0",
    "@platejs/callout": "^53.0.0",
    "@platejs/caption": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/combobox": "^53.0.0",
    "@platejs/date": "^53.0.0",
    "@platejs/dnd": "^53.3.8",
    "@platejs/docx-io": "^53.3.10",
    "@platejs/emoji": "^53.1.7",
    "@platejs/floating": "^53.0.0",
    "@platejs/footnote": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/layout": "^53.0.0",
    "@platejs/link": "^53.3.5",
    "@platejs/list": "^53.3.13",
    "@platejs/markdown": "^53.3.12",
    "@platejs/math": "^53.3.12",
    "@platejs/media": "^53.1.4",
    "@platejs/resizable": "^53.0.0",
    "@platejs/selection": "^53.1.6",
    "@platejs/slash-command": "^53.0.0",
    "@platejs/table": "^53.0.9",
    "@platejs/toc": "^53.0.0",
    "@platejs/toggle": "^53.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-toolbar": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@udecode/cn": "^52.3.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "katex": "^0.18.7",
    "lodash": "^4.18.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.47.0",
    "platejs": "^53.3.11",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-lite-youtube-embed": "^3.7.0",
    "react-player": "^3.3.1",
    "react-textarea-autosize": "^8.5.9",
    "react-tweet": "^3.3.1",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "use-file-picker": "^2.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postcss": "^8",
    "postcss-prefix-selector": "^2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4",
    "tsup": "^8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
